# Copy to infra/.env (or a repo-root .env) and adjust as needed.
# Used by infra/docker-compose.yml. See infra/README.md for the full narrative
# behind each service; this file is the variable reference.
#
# Two kinds of value appear below, and the comments call out which is which:
#   - Compose-network values: how one Compose service reaches another
#     (by service name, e.g. `postgres`, `redis`, `validation-service`) --
#     these are what docker-compose.yml's own defaults use.
#   - Local, non-Compose-dev values: how a service run directly on the host
#     (e.g. `uv run uvicorn ...`, outside Docker entirely) reaches the same
#     dependency via its host-published port (`localhost:<port>`).
# The two are never the same value for a given dependency, so double check
# which situation you're in before copying a default as-is.

# --- postgres service (INF-001) ---------------------------------------------
# These configure the postgres container itself (its own credentials/port),
# so they're used identically whether you're reaching it from another Compose
# service (as part of a DATABASE_URL below, host `postgres`) or from the host
# (e.g. `psql`/`alembic` run outside Docker, host `localhost`) -- only the
# hostname half of the connection string differs, not these values.
POSTGRES_USER=naive_first
POSTGRES_PASSWORD=naive_first_dev_password
POSTGRES_DB=naive_first
POSTGRES_PORT=5432

# --- redis service (INF-002) -------------------------------------------------
# Single connection-string env var (mirrors the DATABASE_URL convention below,
# not split host/port/db vars).
# - Local, non-Compose dev (app running on host, Redis published on host port 6379):
#     REDIS_URL=redis://localhost:6379/0
# - Inside Compose (app running as another Compose service, reaching Redis by
#   service name):
#     REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- validation-service (INF-003) --------------------------------------------
# Compose-network hostnames below (not localhost) -- the container reaches
# postgres/redis by service name, not by their host-published ports.
# DATABASE_URL isn't actually used by the app yet (Postgres-backed
# repositories land in VS-013); it's wired through now so it's ready.
# REDIS_URL is likewise wired through but not yet consumed (VS-014).
# Defaults below already match the POSTGRES_*/REDIS_URL defaults above --
# only override if you've changed those.
#   Local, non-Compose dev equivalent (running the service directly on the
#   host instead of via `docker compose up validation-service`):
#     VALIDATION_SERVICE_DATABASE_URL=postgresql://naive_first:naive_first_dev_password@localhost:5432/naive_first
#     VALIDATION_SERVICE_REDIS_URL=redis://localhost:6379/0
#   (validation-service does not actually read either var outside Compose
#   today -- see infra/README.md -- but the local-dev shape is included here
#   for when VS-013/VS-014 land.)
VALIDATION_SERVICE_PORT=8001
VALIDATION_SERVICE_DATABASE_URL=postgresql://naive_first:naive_first_dev_password@postgres:5432/naive_first
VALIDATION_SERVICE_REDIS_URL=redis://redis:6379/0

# --- gateway-api (INF-004) ---------------------------------------------------
# Compose-network hostnames below (not localhost) -- the container reaches
# postgres/validation-service by service name, not by their host-published
# ports. DATABASE_URL isn't actually used by the app yet (Postgres-backed
# repositories targeting the `identity` schema land in GW-012); it's wired
# through now so it's ready, same situation as VALIDATION_SERVICE_DATABASE_URL
# above. Host port defaults to 8000 (validation-service already took 8001).
#   Local, non-Compose dev equivalent (running gateway-api directly on the
#   host, per its own README): gateway-api's own default is
#   `http://localhost:8000` -- that's validation-service's own standalone
#   uvicorn port (not the 8001 host-port Compose maps it to, which only
#   applies when *both* services are running under Compose):
#     GATEWAY_API_VALIDATION_SERVICE_URL=http://localhost:8000
#     GATEWAY_API_DATABASE_URL=postgresql://naive_first:naive_first_dev_password@localhost:5432/naive_first
#   (this is the same Compose-vs-local distinction gateway-api's own README
#   already draws for VALIDATION_SERVICE_URL.)
GATEWAY_API_PORT=8000
GATEWAY_API_VALIDATION_SERVICE_URL=http://validation-service:8000
GATEWAY_API_DATABASE_URL=postgresql://naive_first:naive_first_dev_password@postgres:5432/naive_first
