# Copy to infra/.env (or a repo-root .env) and adjust as needed.
# Used by infra/docker-compose.yml. See infra/README.md for the full narrative
# behind each service; this file is the variable reference.
#
# Two kinds of value appear below, and the comments call out which is which:
#   - Compose-network values: how one Compose service reaches another
#     (by service name, e.g. `postgres`, `redis`, `validation-service`) --
#     these are what docker-compose.yml's own defaults use.
#   - Local, non-Compose-dev values: how a service run directly on the host
#     (e.g. `uv run uvicorn ...`, outside Docker entirely) reaches the same
#     dependency via its host-published port (`localhost:<port>`).
# The two are never the same value for a given dependency, so double check
# which situation you're in before copying a default as-is.

# --- postgres service (INF-001) ---------------------------------------------
# These configure the postgres container itself (its own credentials/port),
# so they're used identically whether you're reaching it from another Compose
# service (as part of a DATABASE_URL below, host `postgres`) or from the host
# (e.g. `psql`/`alembic` run outside Docker, host `localhost`) -- only the
# hostname half of the connection string differs, not these values.
POSTGRES_USER=naive_first
POSTGRES_PASSWORD=naive_first_dev_password
POSTGRES_DB=naive_first
POSTGRES_PORT=5432

# --- app role (INF-014) -------------------------------------------------------
# Two distinct roles, not one, as of INF-014:
#   - naive_first (above): migration-only. Superuser, schema owner, runs
#     `alembic upgrade head`. Never used as a running service's DATABASE_URL
#     credential -- Postgres unconditionally exempts superusers from RLS
#     (FORCE ROW LEVEL SECURITY included), so connecting as it would silently
#     defeat the tenant-isolation policies in
#     validation-service's/gateway-api's own 0002_* migrations.
#   - naive_first_app (below): runtime-only. NOSUPERUSER NOBYPASSRLS
#     NOCREATEDB NOCREATEROLE, with SELECT/INSERT/UPDATE/DELETE on
#     validation.* and identity.* tables only (no CREATE, no ownership) --
#     this is the role validation-service's/gateway-api's own DATABASE_URL
#     below actually connects as. Created by
#     infra/postgres-init/02-create-app-role.sh on a fresh volume boot; see
#     infra/README.md for how this was additionally applied to an
#     already-running container/volume.
POSTGRES_APP_USER=naive_first_app
POSTGRES_APP_PASSWORD=naive_first_app_dev_password

# --- redis service (INF-002) -------------------------------------------------
# Single connection-string env var (mirrors the DATABASE_URL convention below,
# not split host/port/db vars).
# - Local, non-Compose dev (app running on host, Redis published on host port 6379):
#     REDIS_URL=redis://localhost:6379/0
# - Inside Compose (app running as another Compose service, reaching Redis by
#   service name):
#     REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- validation-service (INF-003) --------------------------------------------
# Compose-network hostnames below (not localhost) -- the container reaches
# postgres/redis by service name, not by their host-published ports.
# DATABASE_URL connects as naive_first_app (INF-014, runtime-only, RLS-bound)
# -- not naive_first, which is migration-only (see the app-role section
# above). REDIS_URL is wired through but not yet consumed (VS-014).
# Defaults below already match the POSTGRES_*/POSTGRES_APP_*/REDIS_URL
# defaults above -- only override if you've changed those.
#   Local, non-Compose dev equivalent (running the service directly on the
#   host instead of via `docker compose up validation-service`):
#     VALIDATION_SERVICE_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@localhost:5432/naive_first
#     VALIDATION_SERVICE_REDIS_URL=redis://localhost:6379/0
#   (validation-service does not actually read either var outside Compose
#   today -- see infra/README.md -- but the local-dev shape is included here
#   for when VS-014 lands.)
VALIDATION_SERVICE_PORT=8001
VALIDATION_SERVICE_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@postgres:5432/naive_first
VALIDATION_SERVICE_REDIS_URL=redis://redis:6379/0

# --- gateway-api (INF-004) ---------------------------------------------------
# Compose-network hostnames below (not localhost) -- the container reaches
# postgres/validation-service by service name, not by their host-published
# ports. DATABASE_URL connects as naive_first_app (INF-014, runtime-only,
# RLS-bound), same situation as VALIDATION_SERVICE_DATABASE_URL above. Host
# port defaults to 8000 (validation-service already took 8001).
#   Local, non-Compose dev equivalent (running gateway-api directly on the
#   host, per its own README): gateway-api's own default is
#   `http://localhost:8000` -- that's validation-service's own standalone
#   uvicorn port (not the 8001 host-port Compose maps it to, which only
#   applies when *both* services are running under Compose):
#     GATEWAY_API_VALIDATION_SERVICE_URL=http://localhost:8000
#     GATEWAY_API_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@localhost:5432/naive_first
#   (this is the same Compose-vs-local distinction gateway-api's own README
#   already draws for VALIDATION_SERVICE_URL.)
GATEWAY_API_PORT=8000
GATEWAY_API_VALIDATION_SERVICE_URL=http://validation-service:8000
GATEWAY_API_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@postgres:5432/naive_first

# --- reporting-service (INF-018) ----------------------------------------------
# Compose-network hostnames below (not localhost) -- the container reaches
# postgres/redis/validation-service by service name, not by their
# host-published ports. DATABASE_URL connects as naive_first_app (INF-014,
# runtime-only, RLS-bound), same situation as VALIDATION_SERVICE_DATABASE_URL/
# GATEWAY_API_DATABASE_URL above. Unlike validation-service, REDIS_URL here is
# a real depends_on (service_healthy), not just wired-through-unused, since
# reporting-service needs Redis ready for RS-006's future run.completed
# subscriber. Host port defaults to 8002 (validation-service/gateway-api
# already took 8001/8000) -- not yet reachable from outside the Docker
# network (see GW-018, the sibling ticket that exposes this through
# gateway-api; this port binding is Compose-network-internal only, per the
# same 127.0.0.1-bound precedent validation-service's own entry documents).
#   Local, non-Compose dev equivalent (running the service directly on the
#   host instead of via `docker compose up reporting-service`):
#     REPORTING_SERVICE_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@localhost:5432/naive_first
#     REPORTING_SERVICE_REDIS_URL=redis://localhost:6379/0
#     REPORTING_SERVICE_VALIDATION_SERVICE_URL=http://localhost:8001
REPORTING_SERVICE_PORT=8002
REPORTING_SERVICE_DATABASE_URL=postgresql://naive_first_app:naive_first_app_dev_password@postgres:5432/naive_first
REPORTING_SERVICE_REDIS_URL=redis://redis:6379/0
REPORTING_SERVICE_VALIDATION_SERVICE_URL=http://validation-service:8000

# --- minio service (INF-008) -------------------------------------------------
# These configure the minio container itself (its own credentials/ports), so
# they're used identically whether reached from another Compose service (by
# service name, `minio`) or from the host (`localhost`) -- only the hostname
# half of the connection would differ, not these values. No service currently
# reads or writes to this bucket store -- ingestion-service (trigger #6) is
# the first real consumer and hasn't been built yet.
MINIO_ROOT_USER=naive_first
MINIO_ROOT_PASSWORD=naive_first_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
