{
  "name": "admin",
  "description": "Operator-persona walkthrough. Logs in as BOTH a tenant and an operator, because /monitoring mixes operator-scoped panels (service health, recent errors, run throughput) with tenant-scoped ones (crawl status, generate a report) that only render with a tenant session.",
  "steps": [
    {
      "name": "tenant_login_page",
      "action": "get",
      "path": "/login",
      "screenshot": true
    },
    {
      "name": "tenant_login_submit",
      "action": "fill_and_submit",
      "form_selector": "form[action='/login']",
      "fields": {
        "api_key": "{api_key}"
      },
      "screenshot": true,
      "follow_redirect": true
    },
    {
      "name": "operator_login_page",
      "action": "get",
      "path": "/operator-login",
      "screenshot": true
    },
    {
      "name": "operator_login_submit",
      "action": "fill_and_submit",
      "form_selector": "form[action='/operator-login']",
      "fields": {
        "operator_token": "{operator_token}"
      },
      "screenshot": true,
      "follow_redirect": true
    },
    {
      "name": "monitoring_page",
      "action": "get",
      "path": "/monitoring",
      "screenshot": true
    },
    {
      "name": "trigger_crawl",
      "action": "click",
      "selector": "form[hx-post^='/monitoring/connectors/'][hx-post$='/run'] button[type='submit']",
      "screenshot": true
    },
    {
      "name": "crawl_status_after_trigger",
      "action": "get",
      "path": "/monitoring/crawl-status-fragment",
      "screenshot": true
    },
    {
      "name": "generate_report_form",
      "action": "get",
      "screenshot": true,
      "path": "/monitoring"
    },
    {
      "name": "generate_report_submit",
      "action": "fill_and_submit",
      "form_selector": "form[hx-post='/monitoring/reports/generate']",
      "fields": {
        "run_id": "{first_option}"
      },
      "screenshot": true
    },
    {
      "name": "settings_connectors",
      "action": "get",
      "path": "/settings/connectors",
      "screenshot": true
    },
    {
      "name": "settings_connectors_lookup",
      "action": "fill_and_submit",
      "form_selector": "form[action='/settings/connectors']",
      "fields": {
        "tenant_id": "{tenant_id}"
      },
      "screenshot": true,
      "follow_redirect": true,
      "verify_against": {
        "method": "GET",
        "path": "/ingestion/connectors/credentials-status?tenant_id={tenant_id}",
        "extract_fields": [
          "source",
          "credential_set"
        ]
      }
    },
    {
      "name": "tenant_management",
      "action": "get",
      "path": "/settings/tenants",
      "screenshot": true,
      "verify_against": {
        "method": "GET",
        "path": "/tenants",
        "extract_fields": [
          "name",
          "id"
        ]
      }
    },
    {
      "name": "tenant_create",
      "action": "fill_and_submit",
      "form_selector": "form[action='/settings/tenants']",
      "fields": {
        "tenant_name": "agent-uat-tenant"
      },
      "screenshot": true
    },
    {
      "name": "tenant_revoke",
      "action": "click",
      "selector": "form[hx-post*='/api-keys/'][hx-post$='/revoke'] button[type='submit']",
      "screenshot": true
    }
  ]
}